# ==========================================
# NexBridge.ai — Backend Environment Config
# ==========================================

# 1. Supabase Project Credentials
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Database Connection
# For standard direct connection:
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
# For IPv4 connection pooler (recommended for cloud and local setups without IPv6):
SUPABASE_POOLER_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# 3. AI / LLM Configuration
# Leave GEMINI_API_KEY empty to activate zero-latency seeded demo fallback mode
GEMINI_API_KEY=your-gemini-api-key-optional
GEMINI_MODEL=gemini-2.5-flash

# 4. Server Configuration
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
