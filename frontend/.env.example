# ==========================================
# NexBridge.ai — Frontend Environment Config
# ==========================================

# Set to 'false' to communicate with the FastAPI backend, or 'true' for local client mocks
VITE_USE_MOCKS=false

# FastAPI Backend API Base URL
VITE_API_URL=http://localhost:8000/api

# Supabase Client Authentication (Used ONLY for auth token management; all data routes through FastAPI)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
